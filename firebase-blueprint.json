{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information about the authenticated teacher",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User authentication identifier"
        },
        "email": {
          "type": "string",
          "description": "Teacher email address"
        },
        "displayName": {
          "type": "string",
          "description": "Teacher display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Record creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Record update timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "TeacherRecord": {
      "title": "TeacherRecord",
      "description": "User cloud stored registry data (groups, students, evaluations, attendance, planners, schedule, settings)",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user identifier"
        },
        "userEmail": {
          "type": "string",
          "description": "Teacher email address"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last synchronization timestamp"
        },
        "teacherInfo": {
          "type": "object",
          "description": "Teacher profile and school information"
        },
        "groups": {
          "type": "array",
          "description": "Academic groups and classrooms"
        },
        "students": {
          "type": "array",
          "description": "Enrolled student lists"
        },
        "evaluationColumns": {
          "type": "array",
          "description": "Configured trimester evaluations"
        },
        "grades": {
          "type": "object",
          "description": "Student grade records"
        },
        "attendanceRecords": {
          "type": "object",
          "description": "Daily student attendance records"
        },
        "themePlanners": {
          "type": "array",
          "description": "Quarterly theme planners (MEDUCA)"
        },
        "weeklyPlanners": {
          "type": "array",
          "description": "Weekly lesson sequences"
        },
        "scheduleSlots": {
          "type": "array",
          "description": "Weekly timetable slots"
        },
        "schedulePeriods": {
          "type": "array",
          "description": "Timetable period configuration"
        },
        "calendarConfig": {
          "type": "object",
          "description": "Academic calendar configuration"
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records indexed by auth UID"
    },
    "/teacher_records/{userId}": {
      "schema": "TeacherRecord",
      "description": "Comprehensive teacher academic records indexed by teacher auth UID"
    }
  }
}
